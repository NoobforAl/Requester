# Copy to `.env` (git-ignored). docker compose reads it automatically.
# Everything here is optional for `make dev`; the Docker stack needs SECRET_KEY
# unless you use `make docker-up` (which turns on development defaults).

# --- Django -----------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# Base of the links placed in e-mails (job alerts).
SITE_URL=http://localhost:8000

# --- Database / cache passwords (defaults are for local development only) ---
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
REDIS_PASSWORD=change-me-as-well

# --- AI resume summaries ------------------------------------------------------
# auto = OpenRouter if OPENROUTER_API_KEY is set, else local Ollama if
# LLAMA_SERVER_URL is set, else summaries are off. Other values: openrouter, ollama, none.
AI_PROVIDER=auto
# Get a key at https://openrouter.ai/keys . Enabling this sends the text of uploaded
# resumes to OpenRouter and the model provider behind it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Local alternative: `docker compose --profile local-ai up` and set
# LLAMA_SERVER_URL=http://llm:11434
LLAMA_SERVER_URL=
LLAMA_MODEL=llama3.2

# --- Admin ----------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
