# Copy to `.env` (git-ignored). docker compose reads it automatically.
# Everything here is optional for `make dev`; the Docker stack needs SECRET_KEY
# unless you use `make docker-up` (which turns on development defaults).

# --- Django -----------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
# Base of the links placed in e-mails (job alerts).
SITE_URL=http://localhost:8000

# --- Database / cache passwords (defaults are for local development only) ---
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
REDIS_PASSWORD=change-me-as-well

# --- AI resume summaries ------------------------------------------------------
# On when OPENROUTER_API_KEY is set, skipped otherwise. Get a key at
# https://openrouter.ai/keys . Enabling this sends the text of uploaded resumes to
# OpenRouter and the model provider behind it.
OPENROUTER_API_KEY=
# Default: a very light (4B), multilingual model. Any OpenRouter model id works.
OPENROUTER_MODEL=google/gemma-3-4b-it

# --- Admin ----------------------------------------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=

# --- Observability (everything is off or safe by default) ---------------------
# Logs: one JSON object per line on stdout. LOG_FORMAT=console for local dev
# (the default when DJANGO_DEBUG is on), json otherwise.
LOG_LEVEL=INFO
LOG_FORMAT=json
# Set per container by docker compose (web / tasks / scheduler).
SERVICE_NAME=web
APP_ENVIRONMENT=development
# Defaults to the version in pyproject.toml; CI can set the git SHA.
APP_VERSION=

# Metrics: django-prometheus. /metrics returns 404 unless METRICS_TOKEN is set
# and sent as "Authorization: Bearer <token>". Never expose /metrics publicly.
PROMETHEUS_ENABLED=false
METRICS_TOKEN=
# Optional extra check: comma-separated CIDRs REMOTE_ADDR must be in (empty = token only).
METRICS_ALLOWED_IPS=
# Needed with several gunicorn workers (set in the monitoring compose file).
PROMETHEUS_MULTIPROC_DIR=

# Tracing: OpenTelemetry over OTLP/HTTP to the collector.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# Parent-based trace-id ratio sampling (0.0 - 1.0).
OTEL_TRACES_SAMPLER_ARG=0.1
# Standard OTel override of the sampler above, e.g. always_on (optional).
OTEL_TRACES_SAMPLER=
# Comma-separated URL regexes not traced (default: /metrics, /static/, /favicon.ico).
OTEL_PYTHON_DJANGO_EXCLUDED_URLS=

# Errors: Sentry is off while SENTRY_DSN is empty. PII is never sent.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# Sentry environment; defaults to APP_ENVIRONMENT.
SENTRY_ENVIRONMENT=

# Dev-only profilers (need DJANGO_DEBUG=true and the dev dependency group).
DEBUG_TOOLBAR=false
SILK_ENABLED=false

# Monitoring stack (docker-compose.monitoring.yaml)
GRAFANA_ADMIN_PASSWORD=change-me
