{
  "index_patterns": [
    "requester-searches"
  ],
  "priority": 200,
  "_meta": {
    "description": "Requester analytics copy, written by Logstash (elastic/logstash). See docs/analytics.md."
  },
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": "false",
      "properties": {
        "id": {
          "type": "long"
        },
        "query": {
          "type": "keyword",
          "fields": {
            "text": {
              "type": "text"
            }
          }
        },
        "location": {
          "type": "keyword"
        },
        "work_mode": {
          "type": "keyword"
        },
        "employment_type": {
          "type": "keyword"
        },
        "seniority": {
          "type": "keyword"
        },
        "min_salary": {
          "type": "long"
        },
        "remote_only": {
          "type": "boolean"
        },
        "language": {
          "type": "keyword"
        },
        "results": {
          "type": "integer"
        },
        "zero_results": {
          "type": "boolean"
        },
        "created_at": {
          "type": "date"
        },
        "skills": {
          "type": "keyword"
        }
      }
    }
  }
}
